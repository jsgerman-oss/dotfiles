#!/usr/bin/env bash
# Global commit-msg hook (managed by dotfiles).
#
# Activated by: git config --global core.hooksPath ~/.dotfiles/.githooks
# (set automatically by install.sh)
#
# Rejects commit messages that attribute work to an AI/LLM. Per-repo
# extension: drop a `commit-msg.local` next to this file in any repo's
# top-level `.githooks/` and it will run after the global gate passes.
#
# Bypass for emergencies: `git commit --no-verify` (logged here so you
# can grep your own audit trail later).

set -euo pipefail

msg_file="$1"

# ─── Forbidden patterns ──────────────────────────────────────────
# Each entry is an extended regex. Order doesn't matter; we report all
# matches at once so the user fixes everything in one pass.
forbidden_patterns=(
    '^Co-[Aa]uthored-[Bb]y:.*([Cc]laude|[Aa]nthropic|GPT|OpenAI|Gemini|Copilot|Cursor|Devin|Aider)'
    '^Co-[Aa]uthored-[Bb]y:.*<noreply@anthropic\.com>'
    '^🤖 [Gg]enerated with'
    '^[Gg]enerated with \[Claude'
    '\[Claude Code\]\(https://claude\.com'
    'AI-[Aa]ssisted'
    '[Vv]ia Claude'
    '[Pp]owered by Claude'
    'Generated by (Claude|GPT|Anthropic|OpenAI|an LLM)'
)

found=()
for pat in "${forbidden_patterns[@]}"; do
    if grep -qE "$pat" "$msg_file"; then
        # Capture the offending line(s) for clearer feedback
        offending=$(grep -nE "$pat" "$msg_file" | head -3)
        found+=("$pat ↪ $offending")
    fi
done

if [ "${#found[@]}" -gt 0 ]; then
    {
        echo ""
        echo "✘ commit-msg gate: forbidden LLM-attribution pattern(s) detected"
        echo ""
        for entry in "${found[@]}"; do
            echo "  - $entry"
        done
        echo ""
        echo "Rule: never attribute commits to Claude, an AI, or any LLM."
        echo "See ~/.claude/CLAUDE.md → 'Commit attribution — HARD RULE'."
        echo ""
        echo "Fix by removing the offending line(s) and re-running git commit."
        echo "Emergency bypass: git commit --no-verify (logged in your reflog)."
        echo ""
    } >&2
    exit 1
fi

# ─── Delegate to per-repo hook if present ────────────────────────
toplevel="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$toplevel" ] && [ -x "$toplevel/.githooks/commit-msg.local" ]; then
    exec "$toplevel/.githooks/commit-msg.local" "$@"
fi

exit 0
